{
 "name": "TVMCHMED",
 "short_name": "TVMCHMED",
 "description": "Department of Medicine, Tirunelveli Medical College",
 "start_url": "./",
 "scope": "./",
 "display": "standalone",
 "background_color": "#F4F6FB",
 "theme_color": "#4338CA",
 "icons": [
  {
   "src": "icon-192.png",
   "sizes": "192x192",
   "type": "image/png"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png"
  }
 ],
 "share_target": {
  "action": "./?share-target",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "title": "title",
   "text": "text",
   "url": "url",
   "files": [
    {
     "name": "files",
     "accept": [
      "image/*",
      "application/pdf",
      ".pdf",
      ".jpg",
      ".jpeg",
      ".png"
     ]
    }
   ]
  }
 }
}